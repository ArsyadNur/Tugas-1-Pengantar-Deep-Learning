      "source": [
        "hasil = {}  # menyimpan ringkasan tiap model untuk perbandingan akhir\n",
        "\n",
        "\n",
        "def plot_history(history, judul):\n",
        "    fig, axes = plt.subplots(1, 2, figsize=(10, 4))\n",
        "    epochs = range(1, len(history.history[\"loss\"]) + 1)\n",
        "\n",
        "    for ax, metric in zip(axes, [\"loss\", \"accuracy\"]):\n",
        "        ax.plot(epochs, history.history[metric], label=\"Train\")\n",
        "        ax.plot(epochs, history.history[\"val_\" + metric], label=\"Validation\")\n",
        "        ax.set(xlabel=\"Epoch\", ylabel=metric, title=f\"{judul} - {metric}\")\n",
        "        ax.legend()\n",
        "\n",
        "    plt.tight_layout()\n",
        "    plt.show()\n",
        "\n",
        "\n",
        "def evaluasi(model, judul):\n",
        "    test_loss, test_acc = model.evaluate(x_test, y_test, verbose=0)\n",
        "\n",
        "    probabilitas = model.predict(\n",
        "        x_test,\n",
        "        batch_size=BATCH_SIZE,\n",
        "        verbose=0\n",
        "    )\n",
        "    y_pred = probabilitas.argmax(axis=1)\n",
        "\n",
        "    print(\n",
        "        f\"Test loss: {test_loss:.4f} | \"\n",
        "        f\"Test accuracy: {test_acc:.2%}\"\n",
        "    )\n",
        "\n",
        "    assert np.isclose(test_acc, np.mean(y_pred == y_test), atol=1e-6)\n",
        "\n",
        "    print(\n",
        "        classification_report(\n",
        "            y_test,\n",
        "            y_pred,\n",
        "            target_names=nama_kelas,\n",
        "            zero_division=0\n",
        "        )\n",
        "    )\n",
        "\n",
        "    fig, ax = plt.subplots(figsize=(14, 12))\n",
        "    ConfusionMatrixDisplay.from_predictions(\n",
        "        y_test,\n",
        "        y_pred,\n",
        "        display_labels=nama_kelas,\n",
        "        cmap=\"Blues\",\n",
        "        xticks_rotation=90,\n",
        "        colorbar=False,\n",
        "        ax=ax\n",
        "    )\n",
        "    ax.set_title(f\"{judul} - UC Merced Land Use\")\n",
        "    plt.tight_layout()\n",
        "    plt.show()\n",
        "\n",
        "    return test_loss, test_acc, y_pred, probabilitas\n",
        "\n",
        "\n",
        "def tampilkan_prediksi(y_pred, probabilitas, n=8):\n",
        "    fig, axes = plt.subplots(2, 4, figsize=(13, 6))\n",
        "\n",
        "    for i, ax in enumerate(axes.flat[:n]):\n",
        "        ax.imshow(x_test[i])\n",
        "        ax.set_title(\n",
        "            f\"Asli: {nama_kelas[y_test[i]]}\\n\"\n",
        "            f\"Pred: {nama_kelas[y_pred[i]]} \"\n",
        "            f\"({probabilitas[i].max():.0%})\",\n",
        "            fontsize=9,\n",
        "            color=\"green\" if y_test[i] == y_pred[i] else \"red\"\n",
        "        )\n",
        "        ax.axis(\"off\")\n",
        "\n",
        "    plt.tight_layout()\n",
        "    plt.show()"
      ]
    },
